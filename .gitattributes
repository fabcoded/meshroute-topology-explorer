# The panel's files keep LF in every checkout (also with core.autocrlf on Windows): Rollup copies each module's line
# ends into the bundle, and a copy installed from any checkout serves the bytes HACS serves (issue #16).
custom_components/meshroute_topology_explorer/frontend/** text eol=lf
# The panel bundle is generated by tools/bundle.mjs from frontend/ (issue #16): GitHub collapses it in diffs and git
# shows no text diff for it; review the sources. No export-ignore: pinned copies made with git archive need it.
custom_components/meshroute_topology_explorer/frontend/dist/** linguist-generated=true -diff
